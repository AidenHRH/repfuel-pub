{
  "expo": {
    "name": "RepFuel",
    "slug": "repfuel",
    "version": "0.22.1-stage22",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "repfuel",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#000000",
    "android": {
      "package": "com.aidenhrh.repfuel",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#000000",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#000000",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120
        }
      ],
      "expo-sqlite",
      [
        "expo-camera",
        {
          "cameraPermission": "RepFuel uses the camera to scan food barcodes.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/android-icon-monochrome.png",
          "color": "#6CB4FF"
        }
      ],
      "./plugins/withReleaseSigning",
      "./plugins/withPlayStoreQuery",
      "expo-sharing",
      [
        "expo-image-picker",
        {
          "photosPermission": "RepFuel uses your photos for pictures of the meals you cook.",
          "cameraPermission": "RepFuel uses the camera to scan barcodes and photograph meals you cook."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
